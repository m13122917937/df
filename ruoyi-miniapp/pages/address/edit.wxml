<view class="page"><input placeholder="收货人" data-field="receiverName" bindinput="onInput" /><input placeholder="联系电话" type="number" data-field="receiverPhone" bindinput="onInput" /><input placeholder="省" data-field="provinceName" bindinput="onInput" /><input placeholder="市" data-field="cityName" bindinput="onInput" /><input placeholder="区/县" data-field="districtName" bindinput="onInput" /><textarea placeholder="详细地址" data-field="detailAddress" bindinput="onInput" /><label><switch checked="{{form.defaultAddress}}" bindchange="onDefaultChange" />设为默认地址</label><button type="warn" bindtap="save">保存地址</button></view>

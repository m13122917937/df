<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.subsidy.mapper.GbOrderItemMapper">
    <select id="selectFirstByOrderId" resultType="com.ruoyi.subsidy.domain.GbOrderItem">
        SELECT * FROM gb_order_item WHERE order_id = #{orderId} ORDER BY id ASC LIMIT 1
    </select>
</mapper>

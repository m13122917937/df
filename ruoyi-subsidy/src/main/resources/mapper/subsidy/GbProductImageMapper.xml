<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.subsidy.mapper.GbProductImageMapper">
    <select id="selectByProductId" resultType="com.ruoyi.subsidy.domain.GbProductImage">
        SELECT * FROM gb_product_image WHERE product_id = #{productId} ORDER BY sort_order ASC, id ASC
    </select>
</mapper>
